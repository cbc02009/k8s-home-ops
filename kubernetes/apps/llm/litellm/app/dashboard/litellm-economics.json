(increase(litellm_input_tokens_metric_total[$__range])) or vector(0)) * 0.435 + (sum(increase(litellm_output_tokens_metric_total[$__range])) or vector(0)) * 0.87) / 1e6, \"opt\", \"DeepSeek V4 Pro \u00b7 $0.44/$0.87\", \"\", \"\") or label_replace(((sum(increase(litellm_input_tokens_metric_total[$__range])) or vector(0)) * 0.14 + (sum(increase(litellm_output_tokens_metric_total[$__range])) or vector(0)) * 0.28) / 1e6, \"opt\", \"DeepSeek V4 Flash \u00b7 $0.14/$0.28\", \"\", \"\") or label_replace(vector($sub_opencode), \"opt\", \"\u2192 Your flat subs (USD)\", \"\", \"\")",
